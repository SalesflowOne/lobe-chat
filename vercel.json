{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144"
    }
  },
  "installCommand": "bun install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pathofsoler.com" }],
      "destination": "https://pathofsoler.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pathofsoler.one" }],
      "destination": "https://pathofsoler.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pathofsoler.one" }],
      "destination": "https://pathofsoler.com/:path*",
      "permanent": true
    }
  ]
}
