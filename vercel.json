{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144"
    }
  },
  "installCommand": "bun install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.agentops.pathofsoler.com" }],
      "destination": "https://agentops.pathofsoler.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.pathofsoler.com" }],
      "destination": "https://agentops.pathofsoler.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pathofsoler.com" }],
      "destination": "https://pathofsoler.twenty.com/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pathofsoler.com" }],
      "destination": "https://pathofsoler.twenty.com/:path*",
      "permanent": false
    }
  ]
}
